{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: w64devkit gcc Debug",
            "command": "gcc",
            "args": [
                "-g",
                "-Wall",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe",
                "-lbcrypt"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "cppbuild",
            "label": "C/C++: w64devkit gcc Release",
            "command": "gcc",
            "args": [
                "-O3",
                "-s",
                "-mavx2",
                "-fopt-info-vec-optimized",
                "-Wall",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe",
                "-lbcrypt"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build"
        }
        
    ],
    "version": "2.0.0"
}